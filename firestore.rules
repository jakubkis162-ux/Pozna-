rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTask(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 300 &&
             data.category in ['ucenie', 'uloha', 'projekt'] &&
             data.isMultiDay is bool &&
             data.completed is bool &&
             data.createdAt is string &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('scheduledDate' in data) || (data.scheduledDate is string && data.scheduledDate.size() <= 30)) &&
             (!('estimatedMinutes' in data) || (data.estimatedMinutes is int || data.estimatedMinutes is float)) &&
             (!('parts' in data) || (data.parts is list && data.parts.size() <= 50));
    }

    // Student personal tasks collection
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId) && isValidId(taskId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(taskId) &&
                       isValidTask(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(taskId) &&
                       incoming().userId == existing().userId &&
                       isValidTask(incoming(), userId);

      allow delete: if isOwner(userId) && isValidId(taskId);
    }
  }
}
